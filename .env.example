# Copy to .env. Keep API keys only in .env (ignored by Git).
# Real ticket labelling: python -m scripts.label_api
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_PROMPT_VERSION=triage-api-v1
# LLM_TIMEOUT_SECONDS=30
# LLM_MAX_OUTPUT_TOKENS=64
# # USD per 1 million tokens, for gpt-4o-mini. Update when changing models.
# LLM_INPUT_PRICE_PER_1M=0.15
# LLM_CACHED_INPUT_PRICE_PER_1M=0.075
# LLM_OUTPUT_PRICE_PER_1M=0.60

# Extension: real embeddings instead of the hash embedder (bump EMBEDDING_MODEL_VERSION!)
# EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
